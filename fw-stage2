# ------------------------------------------------------------------
# template firewall IPv4 router cliente
#
# NOTA BENE: nel template e' presente una macro, WAN_IP_INTERFACE, che
# deve essere appositamente espansa in fase di configurazione con:
#
# ether5: in caso di collegamento tra firewall e CPE mediante
#         interfaccia ether5 dedicata
#
# pppoe-out1: in caso di firewall collegato direttamente tramite
#         PPPoE client
#
# wan-VLAN-100: in caso di circuito WAN erogato tramite terminazione
#         ethernet taggata in 802.1q (VLAN utente)
#
# La macro va sostituita PRIMA dell'import, altrimenti RouterOS rifiuta
# le regole con in-interface=WAN_IP_INTERFACE (interfaccia inesistente).
#
# PRIMA DI APPLICARE
#  1) Entra in Safe Mode (Winbox: pulsante "Safe Mode"; terminale: Ctrl+X).
#  2) Popola le address list usate dalle regole (non sono definite qui):
#       /ip firewall address-list add list=IPSecPeers address=<IP peer IPsec>
#       /ip firewall address-list add list=ExternalManagementAllowed address=<IP/subnet gestione>
#       /ip firewall address-list add list=CustomerLAN address=<subnet LAN cliente>
#  3) Il file parte con "remove [find]": cancella TUTTE le regole filter esistenti.
# ------------------------------------------------------------------



# ------------------------------------------------------------------
# Prefissi NOT GLOBALLY ROUTABLE.
# Il nome lista "RFC-3330" resta invariato per compatibilita' (RFC-3330 e'
# obsoleto, sostituito da RFC 5735/6890): aggiunti i due TEST-NET mancanti.

/ip firewall address-list remove [find list="RFC-3330"]
/ip firewall address-list add list="RFC-3330" address=0.0.0.0/8
/ip firewall address-list add list="RFC-3330" address=10.0.0.0/8
/ip firewall address-list add list="RFC-3330" address=127.0.0.0/8
/ip firewall address-list add list="RFC-3330" address=169.254.0.0/16
/ip firewall address-list add list="RFC-3330" address=172.16.0.0/12
/ip firewall address-list add list="RFC-3330" address=192.0.2.0/24
/ip firewall address-list add list="RFC-3330" address=192.168.0.0/16
/ip firewall address-list add list="RFC-3330" address=198.18.0.0/15
/ip firewall address-list add list="RFC-3330" address=198.51.100.0/24
/ip firewall address-list add list="RFC-3330" address=203.0.113.0/24
/ip firewall address-list add list="RFC-3330" address=224.0.0.0/3



# ------------------------------------------------------------------
# Configurazione DEFAULT IPv4 Filtering

/ip firewall filter remove [find]

# ---------------- Chain custom: icmp (solo traffico verso il router) ----------------
/ip firewall filter add chain=icmp action=accept comment="ICMP ECHO REQUEST (limite per sorgente)" icmp-options=8:0 protocol=icmp dst-limit=10,20,src-address/1m
/ip firewall filter add chain=icmp action=accept comment="ICMP ECHO REPLY" icmp-options=0:0 protocol=icmp
/ip firewall filter add chain=icmp action=accept comment="ICMP DESTINATION UNREACHABLE" icmp-options=3:0-15 protocol=icmp
/ip firewall filter add chain=icmp action=accept comment="ICMP TIME EXCEEDED" icmp-options=11:0 protocol=icmp
/ip firewall filter add chain=icmp action=accept comment="ICMP BAD PARAMETER" icmp-options=12:0 protocol=icmp
/ip firewall filter add chain=icmp action=log comment="LOG NOT ALLOWED ICMPs" log-prefix=ICMP-DROP protocol=icmp limit=10/1m,5
/ip firewall filter add chain=icmp action=drop comment="DROP NOT ALLOWED ICMPs" protocol=icmp

# ---------------- Chain custom: std_filters (anti-spoofing) ----------------
/ip firewall filter add chain=std_filters action=log comment="LOG NOT GLOBALLY ROUTABLE - RFC-3330" src-address-list=RFC-3330 log-prefix=DROPv4-RFC-3330 limit=10/1m,5
/ip firewall filter add chain=std_filters action=drop comment="DROP NOT GLOBALLY ROUTABLE - RFC-3330" src-address-list=RFC-3330

# ---------------- Chain custom: connection_filters ----------------
/ip firewall filter add chain=connection_filters action=log comment="LOG INVALID CONNECTIONS" connection-state=invalid log-prefix=DROPv4-INVALID limit=10/1m,5
/ip firewall filter add chain=connection_filters action=drop comment="DROP INVALID CONNECTIONS" connection-state=invalid
/ip firewall filter add chain=connection_filters action=accept comment="ACCEPT ESTABLISHED,RELATED CONNECTIONS" connection-state=established,related

# ---------------- INPUT ----------------
# IPsec / IPIP dai soli peer autorizzati (aggiunti UDP 4500 NAT-T ed ESP, mancanti)
/ip firewall filter add chain=input action=accept comment="ACCEPT IKE/NAT-T FROM IPSecPeers ACCESS LIST" protocol=udp dst-port=500,4500 src-address-list=IPSecPeers
/ip firewall filter add chain=input action=accept comment="ACCEPT ESP FROM IPSecPeers ACCESS LIST" protocol=ipsec-esp src-address-list=IPSecPeers
/ip firewall filter add chain=input action=accept comment="ACCEPT IP-ENCAPSULATED FROM IPSecPeers ACCESS LIST" protocol=ipencap src-address-list=IPSecPeers

# Discovery MNDP solo dalle interfacce LAN (prima era aperto anche da WAN)
/ip firewall filter add chain=input action=accept comment="INPUT DISCOVERY MGMT (ether1)" protocol=udp src-port=5678 dst-port=5678 in-interface=ether1
/ip firewall filter add chain=input action=accept comment="INPUT DISCOVERY MGMT (ether2)" protocol=udp src-port=5678 dst-port=5678 in-interface=ether2

# Gestione esterna (resta prima dei filtri anti-spoofing per ammettere reti di gestione private); scartati i pacchetti invalid
/ip firewall filter add chain=input action=accept comment="ACCEPT ALL FROM ExternalManagementAllowed ADDRESS LIST" connection-state=!invalid src-address-list=ExternalManagementAllowed
/ip firewall filter add chain=input action=accept comment="ACCEPT ALL FROM CustomerLAN ADDRESS LIST (ether1)" in-interface=ether1 src-address-list=CustomerLAN
/ip firewall filter add chain=input action=accept comment="ACCEPT ALL FROM CustomerLAN ADDRESS LIST (ether2)" in-interface=ether2 src-address-list=CustomerLAN

/ip firewall filter add chain=input action=jump jump-target=std_filters in-interface=WAN_IP_INTERFACE comment="STANDARD FILTERS - INPUT"
/ip firewall filter add chain=input action=jump jump-target=std_filters in-interface=ether4 comment="STANDARD FILTERS - INPUT (2ndCircuit)"
/ip firewall filter add chain=input action=jump jump-target=connection_filters in-interface=WAN_IP_INTERFACE comment="CONNECTION FILTERS - INPUT"
/ip firewall filter add chain=input action=jump jump-target=connection_filters in-interface=ether4 comment="CONNECTION FILTERS - INPUT (2ndCircuit)"

# ICMP analizzato solo verso il router (dopo i filtri di connessione)
/ip firewall filter add chain=input action=jump jump-target=icmp protocol=icmp in-interface=WAN_IP_INTERFACE comment="ICMP ANALYSIS - INPUT"
/ip firewall filter add chain=input action=jump jump-target=icmp protocol=icmp in-interface=ether4 comment="ICMP ANALYSIS - INPUT (2ndCircuit)"

# ATTENZIONE: abilitandole si espone la porta a TUTTA Internet. Per la gestione remota usare la lista ExternalManagementAllowed.
/ip firewall filter add chain=input action=accept comment="SSH INPUT MGMT (Default Disabled)" disabled=yes dst-port=22 protocol=tcp
/ip firewall filter add chain=input action=accept comment="WINBOX INPUT MGMT (Default Disabled)" disabled=yes dst-port=8291 protocol=tcp

/ip firewall filter add chain=input action=log comment="LOG TRAFFIC TO BE DENIED (INPUT)" in-interface=WAN_IP_INTERFACE log-prefix=DROPv4-INPUT-DEFAULT limit=10/1m,5
/ip firewall filter add chain=input action=drop comment="DENY NOT PERMITTED TRAFFIC (INPUT)" in-interface=WAN_IP_INTERFACE
/ip firewall filter add chain=input action=log comment="LOG TRAFFIC TO BE DENIED (INPUT - 2ndCircuit)" in-interface=ether4 log-prefix=DROPv4-INPUT-DEFAULT-2ndCircuit limit=10/1m,5
/ip firewall filter add chain=input action=drop comment="DENY NOT PERMITTED TRAFFIC (INPUT - 2ndCircuit)" in-interface=ether4

# ---------------- FORWARD ----------------
# Traffico decifrato/da cifrare da policy IPsec: va accettato prima del filtro RFC-3330,
# altrimenti le subnet private dei siti remoti vengono scartate
/ip firewall filter add chain=forward action=accept comment="ACCEPT IPSEC POLICY IN" ipsec-policy=in,ipsec
/ip firewall filter add chain=forward action=accept comment="ACCEPT IPSEC POLICY OUT" ipsec-policy=out,ipsec

/ip firewall filter add chain=forward action=jump jump-target=std_filters in-interface=WAN_IP_INTERFACE comment="STANDARD FILTERS - FORWARD"
/ip firewall filter add chain=forward action=jump jump-target=std_filters in-interface=ether4 comment="STANDARD FILTERS - FORWARD (2ndCircuit)"
/ip firewall filter add chain=forward action=jump jump-target=connection_filters in-interface=WAN_IP_INTERFACE comment="CONNECTION FILTERS - FORWARD"
/ip firewall filter add chain=forward action=jump jump-target=connection_filters in-interface=ether4 comment="CONNECTION FILTERS - FORWARD (2ndCircuit)"

# (qui vanno i Service Passthrough, vedi in fondo al file: devono stare PRIMA dei drop di default)

/ip firewall filter add chain=forward action=log comment="LOG TRAFFIC TO BE DENIED (FORWARD)" in-interface=WAN_IP_INTERFACE log-prefix=DROPv4-FORWARD-DEFAULT limit=10/1m,5
/ip firewall filter add chain=forward action=drop comment="DENY NOT PERMITTED TRAFFIC (FORWARD)" in-interface=WAN_IP_INTERFACE
/ip firewall filter add chain=forward action=log comment="LOG TRAFFIC TO BE DENIED (FORWARD - 2ndCircuit)" in-interface=ether4 log-prefix=DROPv4-FORWARD-DEFAULT-2ndCircuit limit=10/1m,5
/ip firewall filter add chain=forward action=drop comment="DENY NOT PERMITTED TRAFFIC (FORWARD - 2ndCircuit)" in-interface=ether4



# ------------------------------------------------------------------
# Configurazione IPv4 Service Passthrough
#
# Le regole vanno inserite PRIMA dei drop di default della chain forward
# (place-before sotto) e DOPO i connection filters. Mai con un semplice "add"
# in coda: finirebbero dopo il drop e non verrebbero mai valutate.
#
# Esempio (decommentare e compilare; NON lasciare i segnaposto XX/PPP):
#
# /ip firewall filter add chain=forward action=accept connection-state=new comment="Service HTTPS Passthrough" dst-address=192.168.10.20 dst-port=443 protocol=tcp in-interface=WAN_IP_INTERFACE place-before=[find where comment="LOG TRAFFIC TO BE DENIED (FORWARD)"]
#
#   comment            -> nome servizio
#   dst-port           -> porta
#   protocol           -> tcp o udp
#   in-interface       -> interfaccia WAN (WAN_IP_INTERFACE oppure ether4 per il 2nd circuit)
#   dst-address        -> IP PRIVATO del server (in caso di NAT 1:1 e' l'indirizzo dietro il NAT,
#                         perche' la chain forward vede l'indirizzo gia' tradotto dal dst-nat)
#
# NOTA: l'ICMP echo-request da Internet verso gli host interni non e' piu'
# ammesso di default. Se serve per uno specifico host, aggiungere una regola
# dedicata con protocol=icmp icmp-options=8:0 e dst-address dell'host.
