# =====================================================================
# MonitoredIP (revisione corretta) - log monitor per RouterOS v6/v7
#
# INSTALLAZIONE
#   /system script add name=MonitoredIP policy=read,write,test source=[contenuto di questo file]
#   /system scheduler add name=MonitoredIP interval=5m on-event=MonitoredIP
#   (il nome dello scheduler deve coincidere con scheduleName qui sotto;
#    serve anche /tool e-mail configurato)
#
# FUNZIONAMENTO
#   Cerca nel log i messaggi con prefisso BLACKLIST- (generati da fw-stage.rsc),
#   invia per mail solo quelli nuovi e salva come "segnalibro" l'ultima voce
#   letta (id + messaggio) nel commento dello scheduler. Non dipende dal
#   formato della data, quindi funziona uguale su v6 e v7.
# =====================================================================

# BEGIN SETUP
:local scheduleName "MonitoredIP"
:local emailAddress "user@example.com"
:local logPattern "BLACKLIST-"
# espressioni regolari da ignorare (array vuoto = nessuna esclusione)
:local removeThese [:toarray ""]
# END SETUP

# esce con errore se lo scheduler non esiste
:local schedId [/system scheduler find name=$scheduleName]
:if ([:len $schedId] = 0) do={
    /log warning "[LOGMON] ERROR: scheduler $scheduleName non esiste. Crealo e allinea scheduleName."
    :error "[LOGMON] scheduler non trovato"
}

# segnalibro salvato nel commento dello scheduler: "<id>|<messaggio>"
:local state [/system scheduler get $schedId comment]
:local lastId ""
:local lastMsg ""
:local sep [:find $state "|"]
:if ([:typeof $sep] = "num") do={
    :set lastId [:pick $state 0 $sep]
    :set lastMsg [:pick $state ($sep + 1) [:len $state]]
}

:local entries [/log find where message~$logPattern]
:if ([:len $entries] = 0) do={ :return true }

# il segnalibro esiste ancora nel log? (se no: riavvio o log ruotato -> invio tutto)
:local found false
:if ([:len $lastId] > 0) do={
    :foreach i in=$entries do={
        :if (("$i" = $lastId) && ([/log get $i message] = $lastMsg)) do={ :set found true }
    }
}

# se il segnalibro non c'e', si parte subito a raccogliere
:local sending (!$found)
:local output ""
:local count 0
:local newLastId ""
:local newLastMsg ""

:foreach i in=$entries do={
    :local msg [/log get $i message]
    :local skip false
    :foreach j in=$removeThese do={
        :if ($msg ~ $j) do={ :set skip true }
    }
    :if (($sending = true) && ($skip = false)) do={
        :set output ($output . [/log get $i time] . " " . $msg . "\r\n")
        :set count ($count + 1)
    }
    # dopo aver superato il segnalibro si inizia a raccogliere dalla voce successiva
    :if (($found = true) && ("$i" = $lastId) && ($msg = $lastMsg)) do={ :set sending true }
    :set newLastId "$i"
    :set newLastMsg $msg
}

# nessuna voce nuova da inviare: aggiorna solo il segnalibro
:if ($count = 0) do={
    /system scheduler set $schedId comment=($newLastId . "|" . $newLastMsg)
    :return true
}

# invio mail; il segnalibro avanza solo se l'invio non genera errori
:local sent true
:local subject ("MikroTik alert " . [/system identity get name] . ": " . $count . " nuovi log")
:do {
    /tool e-mail send to=$emailAddress subject=$subject body=$output
} on-error={
    :set sent false
}

:if ($sent = true) do={
    /system scheduler set $schedId comment=($newLastId . "|" . $newLastMsg)
    /log info "[LOGMON] $count nuovi log, mail inviata a $emailAddress"
} else={
    /log warning "[LOGMON] invio mail fallito, riprovo alla prossima esecuzione"
}# BEGIN SETUP
:local scheduleName "MonitoredIP"
:local emailAddress "angelo68000@gmail.com"
:local startBuf [:toarray [/log find message~"ssh_stage1-8291" || message~"ssh_stage1-" || message~"ssh_stage1" ]]
:local removeThese {"nulla nulla nulla"}
# END SETUP

# warn if schedule does not exist
:if ([:len [/system scheduler find name="$scheduleName"]] = 0) do={
  /log warning "[LOGMON] ERROR: Schedule does not exist. Create schedule and edit script to match name"
}

# get last time
:local lastTime [/system scheduler get [find name="$scheduleName"] comment]
# for checking time of each log entry
:local currentTime
# log message
:local message
 
# final output
:local output

:local keepOutput false
# if lastTime is empty, set keepOutput to true
:if ([:len $lastTime] = 0) do={
  :set keepOutput true
}


:local counter 0
# loop through all log entries that have been found
:foreach i in=$startBuf do={

# loop through all removeThese array items
  :local keepLog true
  :foreach j in=$removeThese do={
#   if this log entry contains any of them, it will be ignored
    :if ([/log get $i message] ~ "$j") do={
      :set keepLog false
    }
  }
  :if ($keepLog = true) do={
   :set message [/log get $i message]

#   LOG DATE
#   depending on log date/time, the format may be different. 3 known formats
#   format of jan/01/2002 00:00:00 which shows up at unknown date/time. Using as default
    :set currentTime [ /log get $i time ]
#   format of 00:00:00 which shows up on current day's logs
   :if ([:len $currentTime] = 8 ) do={
     :set currentTime ([:pick [/system clock get date] 0 11]." ".$currentTime)
    } else={
#     format of jan/01 00:00:00 which shows up on previous day's logs
     :if ([:len $currentTime] = 15 ) do={
        :set currentTime ([:pick $currentTime 0 6]."/".[:pick [/system clock get date] 7 11]." ".[:pick $currentTime 7 15])
      }
   }
    
#   if keepOutput is true, add this log entry to output
   :if ($keepOutput = true) do={
     :set output ($output.$currentTime." ".$message."\r\n")
   }
#   if currentTime = lastTime, set keepOutput so any further logs found will be added to output
#   reset output in the case we have multiple identical date/time entries in a row as the last matching logs
#   otherwise, it would stop at the first found matching log, thus all following logs would be output
    :if ($currentTime = $lastTime) do={
     :set keepOutput true
     :set output ""
   }
  }

#   if this is last log entry
  :if ($counter = ([:len $startBuf]-1)) do={
#   If keepOutput is still false after loop, this means lastTime has a value, but a matching currentTime was never found.
#   This can happen if 1) The router was rebooted and matching logs stored in memory were wiped, or 2) An item is added
#   to the removeThese array that then ignores the last log that determined the lastTime variable.
#   This resets the comment to nothing. The next run will be like the first time, and you will get all matching logs
   :if ($keepOutput = false) do={
#     if previous log was found, this will be our new lastTime entry      
     :if ([:len $message] > 0) do={
        :set output ($output.$currentTime." ".$message."\r\n")
      }
    }
  }
  :set counter ($counter + 1)
}

# If we have output, save new date/time, and send email
if ([:len $output] > 0) do={
  /system scheduler set [find name="$scheduleName"] comment=$currentTime
  /tool e-mail send to="$emailAddress" subject="MikroTik alert $currentTime" body="$output"
  /log info "[LOGMON] New logs found, send email"
}
