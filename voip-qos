

Differentiated Service Code Point (DSCP)
'Differentiated Services' is a default network protocol designed to classify and manage network traffic. 

It makes use of DSCP values to prioritise latency for certain traffic types over others.

DSCP Name	DS Field Value (Dec)	IP Precedence (Description)
CS0  0	0: Best Effort
LE	 1	n/a
CS1, AF11-13	8,  10, 12, 14	1: Priority
CS2, AF21-23	16, 18, 20, 22	2: Immediate
CS3, AF31-33	24, 26, 28, 30	3: Flash - mainly used for voice signaling
CS4, AF41-43	32, 34, 36, 38	4: Flash Override
CS5, EF	      40, 46	        5: Critical - mainly used for voice RTP
CS6	          48	            6: Internetwork Control
CS7	          56	            7: Network Control

# ==========================================
# 1. IP FIREWALL MANGLE
# ==========================================

# Pulisci o adatta le regole assicurandoti che passthrough sia corretto (yes per i passaggi intermedi)
/ip firewall mangle

# Traffico SIP (Segnalazione) su UDP
add action=mark-connection chain=forward connection-state=established,related,new \
    dst-address-list=eutelia dst-port=5060 new-connection-mark=sip-connection \
    passthrough=yes protocol=udp comment="SIP Connection (UDP)"

# Traffico STUN
add action=mark-connection chain=forward connection-state=established,related,new \
    dst-address-list=eutelia dst-port=3478 new-connection-mark=stun-connection \
    passthrough=yes protocol=udp comment="STUN Connection"

# Marcatura pacchetti SIP
add action=mark-packet chain=forward connection-mark=sip-connection \
    new-packet-mark=SIP_Packet passthrough=yes comment="Mark SIP Packets"

# Traffico RTP (Flusso Voce) - Intervallo porte tipico Eutelia/VoIP 10000-20000
add action=mark-connection chain=forward connection-state=established,related,new \
    dst-address-list=eutelia new-connection-mark=rtp-connection \
    passthrough=yes protocol=udp src-port=10000-20000 comment="RTP Connection"

# Marcatura pacchetti RTP
add action=mark-packet chain=forward connection-mark=rtp-connection \
    new-packet-mark=RTP_Packet passthrough=yes comment="Mark RTP Packets"

# Marcatura DSCP (EF - Expedited Forwarding = 46) per i pacchetti RTP in uscita/postrouting
add action=change-dscp chain=postrouting new-dscp=46 \
    packet-mark=RTP_Packet passthrough=yes comment="Set DSCP 46 for RTP"


# ==========================================
# 2. QUEUE TREE (QoS)
# ==========================================
/queue tree

# UPLOAD (es. su interfaccia WAN pppoe-out1 o ether1)
add max-limit=20M name=upload parent=pppoe-out1 queue=default comment="Parent Upload"
add limit-at=2M max-limit=2M name=upload_pri_1 packet-mark=RTP_Packet parent=upload priority=1 queue=default
add limit-at=2M max-limit=2M name=upload_pri_2 packet-mark=SIP_Packet parent=upload priority=2 queue=default
add max-limit=16M name=upload_pri_8 packet-mark=no-mark parent=upload queue=default

# DOWNLOAD (es. su interfaccia LAN o bridge)
add max-limit=50M name=download parent=bridge queue=default comment="Parent Download"
add limit-at=2M max-limit=2M name=download_pri_1 packet-mark=RTP_Packet parent=download priority=1 queue=default
add limit-at=2M max-limit=2M name=download_pri_2 packet-mark=SIP_Packet parent=download priority=2 queue=default
add max-limit=46M name=download_pri_8 packet-mark=no-mark parent=download queue=default
